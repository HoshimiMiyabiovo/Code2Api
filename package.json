{
  "name": "code2api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local AI channel gateway: OpenAI/Anthropic compatible API with provider key pooling and failover.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file=test/.env.test --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "migrate-secrets": "node --disable-warning=ExperimentalWarning --import tsx src/tools/migrate-secrets.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
